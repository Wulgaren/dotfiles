#!/usr/bin/env bash
# Start Claude Code on OpenCode Go's DeepSeek V4.1 Flash.
#
# Claude Code is a validated OpenCode Go client: Go recognizes Claude Code's
# native session header, so no wrapper headers are needed.
#
#   ocgo                          DeepSeek V4.1 Flash
#   ocgo --model deepseek-v4-pro  the slower DeepSeek
#
# Other Go models (see the Go plan table) work the same way, for example
# --model gpt-6.1-sol or --model claude-haiku-5-5.
set -euo pipefail

# Personal Console API key (oc_sk_...), not the opencode CLI login.
KEY_FILE="$HOME/.config/opencode-go/key"
if [[ ! -r "$KEY_FILE" ]]; then
  echo "ocgo: no API key at $KEY_FILE" >&2
  echo "ocgo: create a personal key at https://opencode.ai/console, then:" >&2
  echo "ocgo:   mkdir -p ~/.config/opencode-go && printf %s 'oc_sk_...' > $KEY_FILE && chmod 600 $KEY_FILE" >&2
  exit 1
fi
KEY="$(tr -d '[:space:]' <"$KEY_FILE")"
if [[ -z "$KEY" ]]; then
  echo "ocgo: $KEY_FILE is empty" >&2
  exit 1
fi

MODEL="${OCGO_MODEL:-deepseek-v4.1-flash}"

export ANTHROPIC_BASE_URL="https://opencode.ai/inference/go/anthropic"
export ANTHROPIC_AUTH_TOKEN="$KEY"
export ANTHROPIC_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$MODEL"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$MODEL"
export ANTHROPIC_SMALL_FAST_MODEL="$MODEL"
# DeepSeek on Go takes 1M input tokens. Claude Code cannot read that from the
# model ID, so it would otherwise assume a default window and compact early.
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="${OCGO_CONTEXT:-1000000}"

exec claude "$@"
