#!/usr/bin/env bash
# Start Claude Code on Opus 5.5 billed to an Anthropic API key.
#
# ANTHROPIC_API_KEY makes Claude Code ignore the Pro/Max login and charge the
# key instead, so this keeps plain `claude` on the subscription. Side effect:
# claude.ai connectors stay off for the session.
#
#   opus                     interactive session on Opus 5.5
#   opus -p "explain this"   one-shot
#   opus --model claude-sonnet-5-5   any model the key can reach
set -euo pipefail

# The key lives here, not in this repo. See ~/.config/anthropic-api/key.
KEY_FILE="$HOME/.config/anthropic-api/key"
if [[ ! -r "$KEY_FILE" ]]; then
  echo "opus: no API key at $KEY_FILE" >&2
  echo "opus: write your Anthropic key into that file, then chmod 600 it" >&2
  exit 1
fi
KEY="$(tr -d '[:space:]' <"$KEY_FILE")"
if [[ -z "$KEY" ]]; then
  echo "opus: $KEY_FILE is empty" >&2
  exit 1
fi

MODEL="${OPUS_MODEL:-claude-opus-5-5}"

# A base URL or auth token left in the environment would send this key
# somewhere else; drop them so the request goes to api.anthropic.com.
unset ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN

export ANTHROPIC_API_KEY="$KEY"
export ANTHROPIC_MODEL="$MODEL"

exec claude "$@"
