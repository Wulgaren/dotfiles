#!/usr/bin/env bash
# Start Claude Code on Sonnet 5.5 over the subscription.
#
# A wrapper on `opus`, which owns clearing the settings.json model overrides.
#
#   sonnet                        Sonnet 5.5
#   sonnet --model claude-opus-5-5
set -euo pipefail

export OPUS_MODEL="${SONNET_MODEL:-claude-sonnet-5-5}"
exec opus "$@"
