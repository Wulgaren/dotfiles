#!/usr/bin/env bash
# Hand implementation steps to the worker model. The worker edits files in a
# git worktree; the caller plans, gates each step on its check, reviews the
# finished task once, and applies it to the main working tree.
#
#   code-write start  <task> [--with-uncommitted | --from-head]
#   code-write step   <task> --spec "<what to build>" --check "<cmd>" [--continue]
#   code-write review <task> [--intent "<what the user asked for>"]
#   code-write finish <task>
#   code-write abort  <task>
#
# Run every subcommand from inside the main repository. Each step is committed
# on branch grunt/<task>, so `step` prints exactly what that step changed.

set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

# Dependency folders linked from the main tree so checks run in the worktree.
# Each is added to info/exclude, so git status and commits skip it.
LINKED_DIRS=(node_modules .venv venv)

# A task gets one review and one more after new commits. The counter lives in
# the worktree's git dir (state_file), so the limit holds across shell invocations and cannot be
# dodged by rerunning the command.
REVIEW_LIMIT=2

usage() {
  cat >&2 <<EOF
Usage:
  code-write start  <task> [--with-uncommitted | --from-head]
  code-write step   <task> --spec "<what to build>" --check "<cmd>" [--continue]
  code-write review <task> [--intent "<what the user asked for>"]
  code-write finish <task>
  code-write abort  <task>
EOF
  exit 64
}

die() {
  printf '%s\n' "$1" >&2
  exit 1
}

root="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not inside a git repository"

[[ $# -ge 2 ]] || usage
command="$1"
task="$2"
shift 2
[[ "$task" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "task name must be lowercase letters, digits and dashes: $task"

cache_root="${XDG_CACHE_HOME:-$HOME/.cache}"
worktree="${cache_root%/}/grunt/$(basename "$root")-$task"
branch="grunt/$task"

# Per-worktree state file: base commit and worker session.
state_file() {
  printf '%s/grunt-%s' "$(git -C "$worktree" rev-parse --git-dir)" "$1"
}

require_worktree() {
  [[ -d "$worktree" ]] || die "no task '$task'. Run: code-write start $task"
}

commit_all() {
  local message="$1"
  git -C "$worktree" add -A -- .
  git -C "$worktree" -c commit.gpgsign=false -c user.name=grunt -c user.email=grunt@localhost \
    commit -q --no-verify --allow-empty -m "$message"
}

has_changes() {
  [[ -n "$(git -C "$worktree" status --porcelain -- .)" ]]
}

# Link a dependency folder into the worktree. Git Bash on Windows copies a
# `ln -s` directory target, which duplicates a multi-GB node_modules on every
# start; a directory junction shares it and needs no admin rights.
link_dir() {
  local target="$1" link="$2"
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
      if command -v cygpath >/dev/null; then
        cmd //c mklink //J "$(cygpath -w "$link")" "$(cygpath -w "$target")" >/dev/null 2>&1 && return 0
      fi
      ;;
  esac
  ln -s "$target" "$link"
}

# Drop a dependency link without following it. `git worktree remove` recurses
# through a junction and would erase the main tree's copy, so the link goes
# first: rmdir removes a junction alone, and a copied fallback needs rm -rf.
unlink_dir() {
  local link="$1"
  [[ -e "$link" || -L "$link" ]] || return 0
  if [[ -L "$link" ]]; then
    rm -f "$link"
    return 0
  fi
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
      if command -v cygpath >/dev/null; then
        cmd //c rmdir "$(cygpath -w "$link")" >/dev/null 2>&1 && return 0
      fi
      ;;
  esac
  rm -rf "$link"
}

unlink_linked_dirs() {
  local dir
  for dir in "${LINKED_DIRS[@]}"; do
    unlink_dir "$worktree/$dir"
  done
}

# Kill an in-flight `code-write review` for this task (other shell), if any.
kill_review_if_running() {
  local pid_file rpid
  pid_file="$(state_file review-pid)"
  [[ -s "$pid_file" ]] || return 0
  rpid="$(cat "$pid_file")"
  rm -f "$pid_file"
  if [[ "$rpid" =~ ^[0-9]+$ ]] && kill -0 "$rpid" 2>/dev/null; then
    kill -- -"$rpid" 2>/dev/null || kill "$rpid" 2>/dev/null || true
    wait "$rpid" 2>/dev/null || true
  fi
}

start() {
  local carry=""
  case "${1:-}" in
    --with-uncommitted) carry=1 ;;
    --from-head) carry=0 ;;
    "") ;;
    *) usage ;;
  esac

  [[ -e "$worktree" ]] && die "task '$task' already exists at $worktree. Finish or abort it first."

  if [[ -n "$(git -C "$root" status --porcelain)" && -z "$carry" ]]; then
    die "the working tree has uncommitted changes. Ask the user whether the worker should build on them, then rerun with --with-uncommitted or --from-head."
  fi

  mkdir -p "$(dirname "$worktree")"
  git -C "$root" worktree add -q -b "$branch" "$worktree" HEAD

  if [[ "$carry" == 1 ]]; then
    local patch
    patch="$(mktemp)"
    git -C "$root" diff HEAD --binary > "$patch"
    [[ -s "$patch" ]] && git -C "$worktree" apply --binary "$patch"
    rm -f "$patch"
    (cd "$root" && git ls-files --others --exclude-standard -z | tar --null -T - -cf -) | tar -xf - -C "$worktree"
  fi

  # A linked folder is untracked, but git status still lists it. info/exclude
  # keeps it out of git status and commits. The file is shared with the main
  # repository, which is harmless for folders nobody commits.
  local exclude
  exclude="$(git -C "$worktree" rev-parse --git-path info/exclude)"
  mkdir -p "$(dirname "$exclude")"

  for dir in "${LINKED_DIRS[@]}"; do
    [[ -d "$root/$dir" && ! -e "$worktree/$dir" ]] || continue
    link_dir "$root/$dir" "$worktree/$dir"
    grep -qxF "/$dir" "$exclude" 2>/dev/null || printf '/%s\n' "$dir" >>"$exclude"
  done

  # The worker writes its permission config here before each step. It is
  # plumbing, not part of the task, so keep it out of the commits and the diff.
  grep -qxF '/.commandcode/settings.local.json' "$exclude" 2>/dev/null || printf '/.commandcode/settings.local.json\n' >>"$exclude"

  commit_all "grunt base"
  git -C "$worktree" rev-parse HEAD > "$(state_file base)"
  printf 'started %s at %s\n' "$task" "$worktree"
}

step() {
  local spec="" check="" continue_session=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --spec) [[ $# -ge 2 ]] || usage; spec="$2"; shift 2 ;;
      --check) [[ $# -ge 2 ]] || usage; check="$2"; shift 2 ;;
      --continue) continue_session=1; shift ;;
      *) usage ;;
    esac
  done
  [[ -n "$spec" && -n "$check" ]] || usage
  require_worktree

  # Edits the orchestrator made in the worktree since the last step.
  has_changes && commit_all "orchestrator edits"
  local before
  before="$(git -C "$worktree" rev-parse HEAD)"

  # --continue resends the original spec with the review notes, so a worker
  # whose session could not be resumed still has the task.
  local session=""
  if (( continue_session )); then
    [[ -s "$(state_file session)" ]] || die "no worker session to continue for '$task'"
    session="$(cat "$(state_file session)")"
    spec="$(cat "$(state_file spec)")

Review notes on your previous attempt:
$spec"
  else
    printf '%s\n' "$spec" > "$(state_file spec)"
  fi

  cd "$worktree"
  grunt_worker commandcode "$GRUNT_CODER_MODEL" edit "You implement one step of a plan in this repository. A reviewer reads the whole task when every step is done.

- Work inside this directory. Edit files and run commands. The caller commits, so leave git as it is.
- Address files by relative path. Work only inside this directory; writes elsewhere are out of scope.
- Read the files the spec names before editing, and match the patterns, naming and style of the surrounding code.
- Nobody answers questions during this run. When the spec is ambiguous, do what the existing code does and record the assumption.
- Make the smallest change that satisfies the spec.
- Run the check command after editing. Fix and rerun until it passes, or until you are sure the failure lies outside this step.
- Finish with at most 8 bullets: what you changed, the assumptions you made, and anything left undone.

<spec>
$spec
</spec>

<check>
$check
</check>" "$session"
  printf '%s\n' "$WORKER_SESSION" > "$(state_file session)"

  local check_out check_status
  check_out="$(mktemp)"
  set +e
  bash -c "$check" > "$check_out" 2>&1
  check_status=$?
  set -e

  commit_all "step"

  printf '## worker (%s)\n' "$WORKER_BACKEND"
  printf '%s\n\n' "$WORKER_TEXT"
  if (( check_status == 0 )); then
    printf '## check: pass\n\n'
  else
    printf '## check: FAIL (exit %s), last 40 lines\n' "$check_status"
    tail -40 "$check_out"
    printf '\n'
  fi
  rm -f "$check_out"

  local diff
  diff="$(git -C "$worktree" diff "$before" HEAD -- .)"
  printf '## diff\n%s\n' "${diff:-(no changes)}"

  grunt_log "code-write" "$task" "$(printf '%s' "$diff" | wc -l | tr -d ' ')" "${#diff}"
}

review() {
  local intent=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --intent) [[ $# -ge 2 ]] || usage; intent="$2"; shift 2 ;;
      *) usage ;;
    esac
  done
  require_worktree
  # Edits the orchestrator made in the worktree since the last step, so the
  # reviewers see them in the diff.
  has_changes && commit_all "orchestrator edits"

  # Stop the loop where the skill says to. Without this, re-running `review`
  # re-sends the same diff to a frontier model until it finally says clean.
  local reviewed last head
  reviewed="$(cat "$(state_file reviews)" 2>/dev/null || printf '0')"
  reviewed="${reviewed:-0}"
  last="$(cat "$(state_file reviewed-at)" 2>/dev/null || true)"
  head="$(git -C "$worktree" rev-parse HEAD)"
  if (( reviewed >= REVIEW_LIMIT )); then
    die "'$task' has had $reviewed reviews, which is the limit. Fix small findings yourself, then run: code-write finish $task"
  fi
  if (( reviewed > 0 )) && [[ "$head" == "$last" ]]; then
    die "nothing changed since the last review of '$task'. Run a step with --continue, fix it yourself, or run: code-write finish $task"
  fi

  # The reviewers see the whole series at once, so they can judge the task
  # rather than each step in isolation. Neither has an access flag, so they
  # read files but cannot edit or commit.
  local base log diff prompt
  base="$(cat "$(state_file base)")"
  log="$(git -C "$worktree" log --format='%h %s' "$base"..HEAD)"
  diff="$(git -C "$worktree" diff "$base" HEAD -- .)"
  prompt="You review one finished task in this repository before it reaches the user's tree. Judge the code, not the author's summary.

Read as much surrounding code as you need. Report only actionable problems: correctness bugs, missed cases, security issues, broken repo conventions, dead code, tests that prove nothing. Skip style opinions and praise.

Each finding needs the file and line, why it matters, and the smallest fix. Order the findings by severity. When the series is sound, say so in one sentence.

The planner's intent:
${intent:-(not given)}

<commits>
$log
</commits>

<diff>
$diff
</diff>

End with exactly one line, either VERDICT: clean or VERDICT: changes-needed."

  cd "$worktree"
  # Sol reviews the series through the codex CLI. When codex is missing, not
  # signed in, or out of credits, the same prompt runs on the Command Code
  # fallback model at high effort. Record this process so `abort` can kill an
  # in-flight review before removing the worktree.
  printf '%s\n' "$$" >"$(state_file review-pid)"
  local sol_status=0 sol_text="" sol_note="" reviewer_text="" reviewer_verdict=""
  local reviewer_label="$GRUNT_REVIEW_MODEL (codex)"
  # The EXIT trap runs after this function's locals are gone, so the temp path
  # it cleans up stays global. The directory is what survives a killed worker:
  # grunt_try's own cleanup never runs in that case.
  sol_tmp="$(mktemp -d)"
  trap 'rm -rf "$sol_tmp"; rm -f "$(state_file review-pid)"' EXIT

  if GRUNT_WORKER_TMP="$sol_tmp" grunt_try codex "$GRUNT_REVIEW_MODEL" read "$prompt"; then
    sol_text="$WORKER_TEXT"
    reviewer_text="$sol_text"
    reviewer_verdict="$(printf '%s\n' "$reviewer_text" | grep -o 'VERDICT: [a-z-]*' | tail -1 || true)"
  else
    sol_status=1
    sol_note="$WORKER_ERROR"
  fi
  rm -rf "$sol_tmp"

  if (( sol_status != 0 )) || [[ -z "$reviewer_verdict" ]]; then
    printf '## review: %s (codex): unusable (%s)\n%s\n\n' \
      "$GRUNT_REVIEW_MODEL" "${sol_note:-no verdict line}" "$sol_text"
    printf 'review: falling back to %s (command-code, high effort).\n' "$GRUNT_FALLBACK_MODEL" >&2
    GRUNT_EFFORT=high grunt_worker commandcode "$GRUNT_FALLBACK_MODEL" read "$prompt"
    reviewer_text="$WORKER_TEXT"
    reviewer_verdict="$(printf '%s\n' "$reviewer_text" | grep -o 'VERDICT: [a-z-]*' | tail -1 || true)"
    reviewer_label="$GRUNT_FALLBACK_MODEL (command-code, high)"
  fi
  trap - EXIT
  rm -f "$(state_file review-pid)"

  printf '## review: %s\n%s\n\n' "$reviewer_label" "$reviewer_text"

  grunt_log "review" "$task" "$(printf '%s' "$diff" | wc -l | tr -d ' ')" "${#diff}"

  case "$reviewer_verdict" in
    "VERDICT: clean"|"VERDICT: changes-needed")
      # Only a review that produced a verdict counts against the limit.
      printf '%s\n' "$(( reviewed + 1 ))" > "$(state_file reviews)"
      printf '%s\n' "$head" > "$(state_file reviewed-at)"
      ;;
    *)
      printf '\nreview: %s gave no verdict line. Treat the task as unreviewed and rerun.\n' "$reviewer_label" >&2
      exit 1
      ;;
  esac
  if [[ "$reviewer_verdict" == "VERDICT: changes-needed" ]]; then
    printf '\nreview: changes needed. Small findings: fix them yourself in the worktree, then finish (do not re-run the review). Larger findings: send them back with:\n  code-write step %s --continue --spec "<review notes>" --check "<cmd>"\nthen review once more.\n' "$task" >&2
    exit 1
  fi
  printf 'review: clean\n'
}

finish() {
  require_worktree
  has_changes && commit_all "orchestrator edits"

  local patch
  patch="$(mktemp)"
  git -C "$worktree" diff --binary "$(cat "$(state_file base)")" HEAD -- . > "$patch"

  if [[ -s "$patch" ]]; then
    if ! git -C "$root" apply --binary "$patch"; then
      rm -f "$patch"
      die "patch does not apply to $root, which changed since start. The worktree stays at $worktree; resolve by hand, then run: code-write abort $task"
    fi
    git -C "$root" apply --stat "$patch"
  else
    printf 'no changes to apply\n'
  fi
  rm -f "$patch"

  abort
}

abort() {
  require_worktree
  kill_review_if_running
  unlink_linked_dirs
  git -C "$root" worktree remove --force "$worktree"
  git -C "$root" branch -q -D "$branch"
  printf 'removed %s\n' "$worktree"
}

case "$command" in
  start) start "$@" ;;
  step) step "$@" ;;
  review) review "$@" ;;
  finish) finish "$@" ;;
  abort) abort ;;
  *) usage ;;
esac
