#!/usr/bin/env bash
# PreToolUse guard for reads. Three rules:
#
# 1. Whole-file reads over GRUNT_MIN_LINES (default 1000) are denied and pointed
#    at the bulk-reader skill. Same rule for the Read tool and a bare
#    "cat/head/tail <file>" command.
# 2. Generated or vendored files are denied with a "use rg" message.
# 3. Output that would flood the context is capped at GRUNT_MAX_BYTES (default
#    6000): the command runs once, only the first bytes reach the model, and the
#    full output stays in a file the marker names.
#
# The cap covers read-shaped commands and commands that pour out text. A
# read-shaped command is allowed without a permission prompt; any other capped
# command keeps the normal permission flow, so a rewrite never widens what runs
# unprompted. Commands that stream indefinitely are left alone.
#
# Exits 2 to deny the tool call; stderr becomes the reason the agent sees.
# Prints updatedInput JSON to allow or rewrite the call.
# Any internal failure exits 0 (allow). A broken guard must not stop all work.
#
# Speaks Claude Code's hook protocol.

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MIN_LINES="${GRUNT_MIN_LINES:-1000}"
MAX_BYTES="${GRUNT_MAX_BYTES:-6000}"
LOG="${GRUNT_LOG:-$HOME/.claude/grunt.log}"

[[ "${GRUNT_OFF:-}" == "1" ]] && exit 0

input="$(cat)"
tool="$(jq -r '.tool_name // empty' <<<"$input" 2>/dev/null)" || exit 0
[[ -z "$tool" ]] && exit 0

# Capped output is kept here so the model can read the rest of it. Claude Code
# passes a per-session scratchpad; anything else falls back to the temp dir.
OUT_DIR="$(jq -r '.scratchpad_dir // empty' <<<"$input" 2>/dev/null)"
OUT_DIR="${OUT_DIR:-${TMPDIR:-/tmp}}"
[[ -d "$OUT_DIR" ]] || OUT_DIR="${TMPDIR:-/tmp}"

# Generated or vendored files: never worth a whole read.
skip_reason() {
  local path="$1" base
  base="$(basename "$path")"
  case "$base" in
    *.lock|*-lock.json|yarn.lock|pnpm-lock.yaml|go.sum|*.min.js|*.min.css|*.map|*.snap)
      return 0 ;;
  esac
  case "$path" in
    */node_modules/*|*/vendor/*|*/dist/*|*/build/*|*/.next/*|*/target/*|*/__snapshots__/*)
      return 0 ;;
  esac
  return 1
}

# Binary files have no lines worth counting. Read them as usual.
is_binary() {
  case "$1" in
    *.png|*.jpg|*.jpeg|*.gif|*.webp|*.ico|*.pdf|*.zip|*.gz|*.tar|*.mp4|*.mov|*.mp3|*.wasm|*.sqlite|*.db|*.woff|*.woff2|*.ttf)
      return 0 ;;
  esac
  return 1
}

line_count() {
  wc -l < "$1" 2>/dev/null | tr -d ' '
}

file_size() {
  wc -c < "$1" 2>/dev/null | tr -d ' '
}

log_decision() {
  local mode="$1" detail="$2" lines="$3" bytes="$4"
  printf '%s\t%s\t%s\t%s\t%s\n' \
    "$(date '+%Y-%m-%dT%H:%M:%S')" "$mode" "$detail" "$lines" "$bytes" >> "$LOG" 2>/dev/null
}

deny() {
  printf '%s\n' "$1" >&2
  exit 2
}

# Denies a whole-file read of a generated file or one over MIN_LINES. Returns
# (does not exit) when the file is fine or too small to matter.
check_file() {
  local path="$1"

  [[ -f "$path" ]] || return 0
  is_binary "$path" && return 0

  if skip_reason "$path"; then
    log_decision "blocked-generated" "$path" "" ""
    deny "BLOCKED: $path is generated or vendored. Find the exact entry with rg, for example: rg '<pattern>' $path"
  fi

  local lines bytes
  lines="$(line_count "$path")"
  [[ -z "$lines" || "$lines" -le "$MIN_LINES" ]] && return 0

  bytes="$(file_size "$path")"
  log_decision "blocked-bulk" "$path" "$lines" "$bytes"
  deny "BLOCKED: $path is $lines lines. Whole-file reads of this size are blocked.

Use the bulk-reader skill for understanding:
  $ROOT/scripts/bulk-read --question \"<what you need to know>\" --paths $path

Rules:
- One specific question per call. The worker answers with bullets, not file contents.
- A second question about the same files: run bulk-read again. Re-sending is cheap; the files stay out of your context.
- For exact lines to edit, read the range with offset/limit (allowed).
- Keep debugging, design decisions, and safety-critical code in the main model."
}

# The command's segments, one per line, trimmed and without leading NAME=value
# assignments, so "FOO=1 git diff" is judged as git. A misread only changes
# whether the cap applies, never the command itself.
segments_of() {
  local seg
  while IFS= read -r seg; do
    seg="${seg#"${seg%%[![:space:]]*}"}"
    while [[ "$seg" =~ ^[A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+(.*)$ ]]; do
      seg="${BASH_REMATCH[1]}"
    done
    [[ -n "$seg" ]] && printf '%s\n' "$seg"
  done <<< "$(printf '%s' "$1" | sed -E 's/(&&|\|\||;|\|)/\n/g')"
}

# A command whose only output is file contents, so allowing it without a prompt
# is safe. Redirects, substitutions, background jobs and the writing variants of
# the same tools are excluded.
read_shaped() {
  local cmd="${1//2>\/dev\/null/}" seg word
  local writes_file='>([^&]|$)' lone_amp='(^|[^&>])&([^&>]|$)'
  local sed_in_place='(^|[[:space:]])-[A-Za-z]*i|--in-place'
  [[ "$cmd" == *'`'* || "$cmd" == *'$('* || "$cmd" == *'<('* ]] && return 1
  [[ "$cmd" =~ $writes_file || "$cmd" =~ $lone_amp ]] && return 1
  while IFS= read -r seg; do
    word="${seg%%[[:space:]]*}"
    case "$word" in
      sed)  [[ "$seg" =~ $sed_in_place ]] && return 1 ;;
      sort) [[ "$seg" == *" -o"* || "$seg" == *"--output"* ]] && return 1 ;;
      rg)   [[ "$seg" == *"--pre"* ]] && return 1 ;;
      cat|head|tail|cut|uniq|nl|tac|wc|grep|rg|sed|sort) ;;
      *) return 1 ;;
    esac
  done <<< "$(segments_of "$cmd")"
  return 0
}

# Commands that pour out text. Their stdout is capped; stderr and the exit code
# pass through.
noisy() {
  local cmd="$1" seg word
  while IFS= read -r seg; do
    word="${seg%%[[:space:]]*}"
    case "$word" in
      rg|grep|find|ls|tree|git|npm|npx|pnpm|yarn|bun|bunx|cargo|go|make|pytest|jest|vitest|tsc|eslint|ruff|mypy|docker|kubectl|journalctl)
        return 0 ;;
    esac
  done <<< "$(segments_of "$cmd")"
  return 1
}

# Commands that never finish on their own must stream, so buffering them would
# hang the call.
streams_output() {
  local cmd="$1"
  case "$cmd" in
    *'tail -f'*|*'tail -F'*|*'--follow'*|*'--watch'*|*'journalctl -f'*|*' -it '*|*'run dev'*|*'next dev'*|*' serve '*|*'yes '*|*'watch '*)
      return 0 ;;
  esac
  [[ "$cmd" =~ (^|[[:space:]])vite([[:space:]]|$) || "$cmd" =~ [[:space:]]\&[[:space:]]*$ ]]
}

# Wraps the command so stdout is capped at MAX_BYTES. The full output stays on
# disk and the marker names it; stderr and the exit status pass through
# untouched. The allow mode skips the permission prompt, so only read-shaped
# commands use it.
cap_command() {
  local cmd="$1" mode="$2" wrapped reason
  wrapped="__grunt_out=\$(mktemp \"$OUT_DIR/grunt-out.XXXXXX\")
{ $cmd
} >\"\$__grunt_out\"
__grunt_rc=\$?
__grunt_size=\$(wc -c <\"\$__grunt_out\" | tr -d ' ')
head -c $MAX_BYTES \"\$__grunt_out\"
if [ \"\$__grunt_size\" -gt $MAX_BYTES ]; then
  printf '\\n[grunt: stdout cut at $MAX_BYTES of %s bytes.\\n' \"\$__grunt_size\"
  printf 'Full output: %s. Read a range of it with offset/limit, or grep it. Prefix the command with GRUNT_OFF=1 to skip the cap.]\\n' \"\$__grunt_out\"
fi
exit \$__grunt_rc"

  reason="stdout above $MAX_BYTES bytes: capped, the full output is kept on disk"
  if [[ "$mode" == allow ]]; then
    jq -nc --arg cmd "$wrapped" --arg reason "$reason" \
      '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "allow", permissionDecisionReason: $reason, updatedInput: {command: $cmd}}}'
  else
    # No decision, so the normal permission flow still applies to the rewritten
    # command. A cap must not approve a command the user would otherwise be asked
    # about.
    jq -nc --arg cmd "$wrapped" \
      '{hookSpecificOutput: {hookEventName: "PreToolUse", updatedInput: {command: $cmd}}}'
  fi
  exit 0
}

case "$tool" in
  Read)
    file="$(jq -r '.tool_input.file_path // .tool_input.path // empty' <<<"$input")"
    offset="$(jq -r '.tool_input.offset // empty' <<<"$input")"
    limit="$(jq -r '.tool_input.limit // empty' <<<"$input")"
    [[ -z "$file" ]] && exit 0
    [[ -n "$offset" || -n "$limit" ]] && exit 0
    check_file "$file"
    ;;
  Bash)
    cmd="$(jq -r '.tool_input.command // empty' <<<"$input")"
    [[ -z "$cmd" ]] && exit 0

    # The opt-out the cap marker names. The hook's own env is not the command's,
    # so the prefix has to be read from the command text.
    [[ "$cmd" =~ (^|[;\&|[:space:]])GRUNT_OFF=1[[:space:]] ]] && exit 0

    # A bare whole-file read gets the Read-tool rule, so the file stays out of
    # context entirely instead of arriving cut in half. Leading assignments are
    # stripped first, or FOO=1 cat big would slip past the size rule.
    bare="$(segments_of "$cmd")"
    if [[ "$bare" != *"|"* && "$bare" != *">"* && "$bare" != *"<"* && "$bare" != *";"* && "$bare" != *'$('* ]]; then
      if [[ "$bare" =~ ^[[:space:]]*(cat|head|tail|less|more)[[:space:]] ]]; then
        read -r -a words <<< "$bare"
        args=()
        for w in "${words[@]:1}"; do
          [[ "$w" == -* ]] && continue
          args+=("$w")
        done
        [[ "${#args[@]}" -eq 1 ]] && check_file "${args[0]}"
      fi
    fi

    # Everything else that reads or dumps: cap the output. Re-wrapping our own
    # command would nest temp files and markers for no gain, and a command that
    # streams must run unbuffered.
    [[ "$cmd" == *"__grunt_out"* ]] && exit 0
    streams_output "$cmd" && exit 0
    # A background job's output file must fill as it runs, and the cap buffers
    # stdout until the command exits.
    [[ "$(jq -r '.tool_input.run_in_background // false' <<<"$input")" == true ]] && exit 0
    detail="$(printf '%s' "$cmd" | head -c 80)"

    if read_shaped "$cmd"; then
      log_decision "capped-read" "$detail" "" ""
      cap_command "$cmd" allow
    elif noisy "$cmd"; then
      log_decision "capped-output" "$detail" "" ""
      cap_command "$cmd" plain
    fi
    ;;
esac

exit 0
