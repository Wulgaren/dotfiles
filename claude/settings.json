{
  "env": {
    "GRUNT_MIN_LINES": "1000"
  },
  "model": "opus",
  "theme": "auto",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "grunt@natios": true,
    "vercel@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "natios": {
      "source": {
        "source": "directory",
        "path": "/Users/natios/.claude/local-marketplace"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 220000
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "awaySummaryEnabled": false,
  "autoMemoryEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
