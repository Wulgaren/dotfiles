{
  "env": {
    "GRUNT_MIN_LINES": "1000"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "grunt@natios": true
  },
  "extraKnownMarketplaces": {
    "natios": {
      "source": {
        "source": "directory",
        "path": "/Users/natios/.claude/local-marketplace"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 220000
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "awaySummaryEnabled": false,
  "autoMemoryEnabled": true,
  "disableClaudeAiConnectors": true,
  "enableArtifact": false,
  "permissions": {
    "deny": [
      "SendFeedback"
    ]
  },
  "skillOverrides": {
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:skill-creator": "off",
    "anthropic-skills:xlsx": "off"
  },
  "theme": "auto"
}
