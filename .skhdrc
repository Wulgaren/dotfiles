alt - 1 : osascript ~/.config/skhd/open-helium.scpt

alt - return : osascript ~/.config/skhd/open-terminal.scpt
alt - 2 : osascript ~/.config/skhd/open-terminal.scpt

alt - 3 : osascript ~/.config/skhd/open-discord-helium.scpt
alt - 4 : open -a Music
alt - 5 : open -a Finder
alt - 6 : open -a Photos
alt - 7 : open -a Notes
alt - 8 : open -a Reminders

home | play
delete | mute
pageup | sound_up
pagedown | sound_down
cmd - escape : osascript -e 'tell application "System Events" to keystroke "`" using command down'
