# fn - t : open -a Terminal
alt - t : open -a Terminal
alt - return : osascript \
    -e 'tell application "Terminal"' \
    -e 'if (count of windows) is 0 then do script ""' \
    -e 'activate' \
    -e 'end tell'
alt - 2 : osascript \
    -e 'tell application "Terminal"' \
    -e 'if (count of windows) is 0 then do script ""' \
    -e 'activate' \
    -e 'end tell'
fn - t : osascript \
    -e 'tell application "Terminal"' \
    -e 'if (count of windows) is 0 then do script ""' \
    -e 'activate' \
    -e 'end tell'
fn - 2 : osascript \
    -e 'tell application "Terminal"' \
    -e 'if (count of windows) is 0 then do script ""' \
    -e 'activate' \
    -e 'end tell'
ctrl - 2 : osascript \
    -e 'tell application "Terminal"' \
    -e 'if (count of windows) is 0 then do script ""' \
    -e 'activate' \
    -e 'end tell'

alt - m : open -a Music
alt - 4 : open -a Music
fn - 4 : open -a Music
fn - m : open -a Music
ctrl - 4 : open -a Music

alt - f : open -a Finder
alt - 5 : open -a Finder
fn - 5 : open -a Finder
fn - f : open -a Finder
ctrl - 5 : open -a Finder

alt - g : open -a Notes
fn - g : open -a Notes

