alt - b : open -a Safari
alt - 1 : open -a Safari
fn - s : open -a Safari
fn - 1 : open -a Safari
ctrl - 1 : open -a Safari

alt - d : open -a "Discord"
alt - 3 : open -a "Discord"
fn - d : open -a "Discord"
fn - 3 : open -a "Discord"
ctrl - 3 : open -a "Discord"

