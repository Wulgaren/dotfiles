alt - 1 : open -a Helium

alt - return : osascript \
    -e 'tell application "Terminal"' \
    -e 'if (count of windows) is 0 then do script ""' \
    -e 'activate' \
    -e 'end tell'
alt - 2 : osascript \
    -e 'tell application "Terminal"' \
    -e 'if (count of windows) is 0 then do script ""' \
    -e 'activate' \
    -e 'end tell'

alt - 3 : open -a "Discord"
alt - 4 : open -a Music
alt - 5 : open -a Finder
alt - 6 : open -a Photos
alt - 7 : open -a Notes
alt - 8 : open -a Reminders

home | play
delete | mute
pageup | sound_up
pagedown | sound_down
cmd - escape : osascript -e 'tell application "System Events" to keystroke "`" using command down'
