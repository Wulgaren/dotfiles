alt - 1 : open -a Helium

alt - 2 : open -a Ghostty
alt - return : open -a Ghostty

# alt - return : osascript ~/.config/skhd/open-terminal.scpt
# alt - 2 : osascript ~/.config/skhd/open-terminal.scpt

alt - 3 : open -a "Discord"
alt - 4 : open -a Music
alt - 5 : open -a "Grok Bot"
alt - 6 : open -a Photos
alt - 7 : open -a Reminders
alt - 8 : open -a Notes
alt - 9 : open -a Finder
alt - 0 : osascript ~/.config/skhd/quick-note.scpt

# Eject is remapped to F18 at the HID level by skhd/eject-key-remap.sh.
# Absolute path: skhd runs with launchd's default PATH, which lacks /opt/homebrew/bin.
f18 : /opt/homebrew/bin/skhd -k 'cmd + alt - space'

home | play
delete | mute
pageup | sound_up
pagedown | sound_down

# F6 toggles Do Not Disturb. This keyboard reports F6 and Fn+F6 identically,
# so both trigger this and F6 no longer reaches apps.
f6 : /usr/bin/osascript -e 'tell application "System Events" to key code 178'

# Mouse mode: alt-m enters, h/j/k/l move the pointer, u/d scroll, i/o click.
# Shift moves in larger steps; escape exits.
:: mouse
alt - m ; mouse
mouse < h : /usr/bin/python3 ~/.config/skhd/mouse.py move -40 0
mouse < j : /usr/bin/python3 ~/.config/skhd/mouse.py move 0 40
mouse < k : /usr/bin/python3 ~/.config/skhd/mouse.py move 0 -40
mouse < l : /usr/bin/python3 ~/.config/skhd/mouse.py move 40 0
mouse < shift - h : /usr/bin/python3 ~/.config/skhd/mouse.py move -160 0
mouse < shift - j : /usr/bin/python3 ~/.config/skhd/mouse.py move 0 160
mouse < shift - k : /usr/bin/python3 ~/.config/skhd/mouse.py move 0 -160
mouse < shift - l : /usr/bin/python3 ~/.config/skhd/mouse.py move 160 0
mouse < u : /usr/bin/python3 ~/.config/skhd/mouse.py scroll 5
mouse < d : /usr/bin/python3 ~/.config/skhd/mouse.py scroll -5
mouse < shift - u : /usr/bin/python3 ~/.config/skhd/mouse.py scroll 20
mouse < shift - d : /usr/bin/python3 ~/.config/skhd/mouse.py scroll -20
mouse < i : /usr/bin/python3 ~/.config/skhd/mouse.py click left
mouse < o : /usr/bin/python3 ~/.config/skhd/mouse.py click right
mouse < escape ; default
mouse < alt - m ; default

cmd - escape : osascript -e 'tell application "System Events" to keystroke "`" using command down'
