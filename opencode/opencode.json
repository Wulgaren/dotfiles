{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "rmdir *", "effect": "ask" },
    { "action": "shell", "resource": "mv *", "effect": "ask" },
    { "action": "shell", "resource": "dd *", "effect": "ask" },
    { "action": "shell", "resource": "truncate *", "effect": "ask" },
    { "action": "shell", "resource": "shred *", "effect": "ask" },
    { "action": "shell", "resource": "find * -delete*", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git reset *", "effect": "ask" },
    { "action": "shell", "resource": "npm install -g", "effect": "ask" },
    { "action": "shell", "resource": "git checkout -- *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout .", "effect": "ask" },
    { "action": "shell", "resource": "git restore *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "rm */tmp/*", "effect": "allow" },
    { "action": "shell", "resource": "rm */private/var/folders/*", "effect": "allow" },
    { "action": "shell", "resource": "rm *$TMPDIR*", "effect": "allow" },
    { "action": "shell", "resource": "rm *${TMPDIR}*", "effect": "allow" },
    { "action": "shell", "resource": "rmdir */tmp/*", "effect": "allow" },
    { "action": "shell", "resource": "rmdir */private/var/folders/*", "effect": "allow" },
    { "action": "shell", "resource": "find */tmp/* -delete*", "effect": "allow" },
    { "action": "shell", "resource": "find */private/var/folders/* -delete*", "effect": "allow" },
    { "action": "shell", "resource": "find *$TMPDIR* -delete*", "effect": "allow" }
  ],
  "providers": {
    "deeprelay": {
      "name": "deeprelay",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.deeprelay.ai/v1"
      },
      "models": {
        "deeprelay/deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash 1017",
          "limit": { "context": 1048576, "output": 32768 }
        },
        "deeprelay/glm-5.3": {
          "name": "GLM 5.3",
          "limit": { "context": 1048576, "output": 32768 }
        }
      }
    }
  }
}
