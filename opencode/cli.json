{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system",
    "mode": "system"
  },
  "animations": true,
  "attention": {
    "notifications": true
  },
  "session": {
    "permissions": "autoaccept",
    "sidebar": "auto",
    "grouping": "auto",
    "tps": true,
    "verbosity": "medium"
  },
  "prompt": {
    "image_preview": false
  },
  "highlights": true,
  "plugins": [
      "opencode-session-usage"
  ],
  "tabs": {
    "mode": "auto",
    "layout": "horizontal",
    "indicators": "status"
  },
  "diffs": {
    "view": "auto"
  }
}
